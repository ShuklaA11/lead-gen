# Copy this file to .env and paste your own keys. .env is gitignored.

# Apollo.io API key (Professional plan or higher).
# Get it at: Settings > Integrations > API in the Apollo web app.
APOLLO_API_KEY=

# Anthropic API key for writing the outreach emails.
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
